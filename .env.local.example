# ---- Which engine narrates ----
# openrouter (default): OpenRouter chat completions, streamed. Free-tier models available.
# koracle: the K-Oracle LLM gateway (Claude / GPT / Gemini via the andrewKim kit). No streaming.
LLM_PROVIDER=openrouter

# ---- OpenRouter ----
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=minimax/minimax-m3:free

# ---- K-Oracle gateway (only used when LLM_PROVIDER=koracle) ----
# Folder containing the kit's credentials.json (defaults to ../llm-kit-andrewKim-secure_extracted/llm-kit-andrewKim).
# LLM_KIT_DIR=../llm-kit-andrewKim-secure_extracted/llm-kit-andrewKim
# On hosts without the kit folder, paste the credentials.json contents instead:
# KORACLE_CREDENTIALS_JSON={"client_id":"...","private_key":"-----BEGIN PRIVATE KEY-----...","algorithm":"ed25519","endpoint":"https://llm.koracle.me"}
# KORACLE_PROVIDER=anthropic   # anthropic | openai | google
# KORACLE_MODEL=               # optional explicit model id

SITE_URL=http://localhost:3000
